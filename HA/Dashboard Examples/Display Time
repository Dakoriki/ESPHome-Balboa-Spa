#Requires button-card

type: custom:button-card
show_icon: false
show_name: true
entity: sensor.spa_esphome_hour
name: |
  [[[ let hr = Math.trunc(states['sensor.spa_esphome_hour'].state);
      let mi = Math.trunc(states['sensor.spa_esphome_minute'].state);
      return (hr > 9 ? hr : '0' + hr) + ':' + (mi > 9 ? mi : '0' + mi);]]]
show_label: true
styles:
  card:
    - height: 100%
    - font-size: 25px
tap_action:
  action: none
